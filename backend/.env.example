# Copy to `.env` for local runs (npm start loads it). On a host (Render, Railway, Docker) set these as environment variables instead.
# NEVER commit the real .env file.

NODE_ENV=production
PORT=3001
APP_URL=https://your-domain.example          # public https address (used in emailed links)
DATA_DIR=/data                               # persistent disk: holds the database, photos and backups
TRUST_PROXY=1                                # 1 when behind Render/Railway/Caddy/nginx (so client IPs are right for rate limits)

# 32+ random characters. Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=

# First administrator (created once if no admin exists). Change the password after first login. 2FA is forced on.
ADMIN_EMAIL=you@your-domain.example
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Email (verification, password reset, booking notices). Resend: https://resend.com
MAIL_PROVIDER=resend
MAIL_FROM=AgriShare <no-reply@your-domain.example>
RESEND_API_KEY=

# Phone app: push notifications through Firebase Cloud Messaging (optional)
# PUSH_PROVIDER=fcm
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional
# ALLOW_INSECURE_DEFAULTS=true        bypasses strict production mail/https checks for staging/test deploys
# GEOCODER=nominatim                 free-text address search (farm names, villages) via OpenStreetMap
# ERROR_WEBHOOK_URL=                 Slack/Discord/Teams webhook that receives server errors
# ALLOWED_ORIGINS=https://app.your-domain.example   extra origins allowed to call the API with a token
# ALLOW_NATIVE_ORIGINS=true          lets local dev tools and Expo web call the API (default on)
# REQUIRE_VERIFIED_EMAIL=true        (default in production)
# REQUIRE_ADMIN_2FA=true             (default in production)
# BACKUP_KEEP=14
